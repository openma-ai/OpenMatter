{
  "name": "@openma/matter-host-local",
  "version": "0.2.7",
  "description": "Long-connection host for OpenMatter in a long-running Node.js process: the generic runtime that drives any outbound-connection event source into a durable inbox, plus Slack Socket Mode.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openma-ai/OpenMatter.git",
    "directory": "packages/host-local"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@openma/matter": "workspace:*",
    "@slack/socket-mode": "3.0.0",
    "undici": "7.29.0"
  },
  "peerDependencies": {
    "effect": "^3.22.1"
  }
}
