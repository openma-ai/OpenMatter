{
  "name": "@openma/matter-project-host",
  "version": "0.2.8",
  "description": "Local Node.js host for OpenMatter Projects: SQLite store and inbox, project runtime, and host injection points for integrations and Turn grants.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openma-ai/OpenMatter.git",
    "directory": "packages/project-host"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@openma/matter": "workspace:*",
    "@openma/matter-inbox-sqlite": "workspace:*",
    "@openma/matter-orchestration": "workspace:*",
    "@openma/matter-project": "workspace:*",
    "@openma/matter-store-sqlite": "workspace:*"
  },
  "peerDependencies": {
    "effect": "^3.22.1"
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
