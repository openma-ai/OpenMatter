{
  "name": "@openma/matter-store-sqlite",
  "version": "0.2.7",
  "description": "Embedded SQLite store for OpenMatter on Node.js (node:sqlite): Turns, Agent sessions, operation calls, conversation entries, and effect deliveries for a single-process host.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openma-ai/OpenMatter.git",
    "directory": "packages/store-sqlite"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@openma/matter": "workspace:*"
  },
  "peerDependencies": {
    "effect": "^3.22.1"
  },
  "engines": {
    "node": ">=22.13"
  }
}
