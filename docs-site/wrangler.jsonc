{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openmatter-docs",
  "compatibility_date": "2026-08-23",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "matter.openma.dev", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
