{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@openma/matter-core": ["./packages/core/src/index.ts"],
      "@openma/matter-openapi": ["./packages/openapi/src/index.ts"],
      "@openma/matter-runtime": ["./packages/runtime/src/index.ts"],
      "@openma/matter-agent-openma": ["./packages/agent-openma/src/index.ts"],
      "@openma/matter-testing": ["./packages/testing/src/index.ts"]
