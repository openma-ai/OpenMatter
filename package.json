{
  "name": "openmatter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsdown",
    "build:projects": "tsdown --filter @openmatter/project --filter @openmatter/project-host --filter @openmatter/project-mcp --filter @openmatter/store-sqlite --filter @openmatter/store-mysql --filter @openmatter/project-worker",
    "check": "pnpm format:check && pnpm test && pnpm typecheck && pnpm build",
    "format": "prettier --write packages tests examples *.json *.ts *.yaml README.md docs/*.md",
    "format:check": "prettier --check packages tests examples *.json *.ts *.yaml README.md docs/*.md",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "effect": "3.22.1",
    "prettier": "3.9.6",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "unrun": "0.3.1",
    "vitest": "4.1.11"
  }
}
